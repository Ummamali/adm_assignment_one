import os
import warnings
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from scipy import stats

# Suppress repetitive warnings for clean output
warnings.filterwarnings('ignore')

# Scikit-Learn
from sklearn.model_selection import train_test_split, StratifiedKFold, RandomizedSearchCV
from sklearn.preprocessing import RobustScaler
from sklearn.compose import ColumnTransformer
from sklearn.metrics import (
    precision_score, recall_score, f1_score, matthews_corrcoef,
    roc_auc_score, average_precision_score, confusion_matrix,
    roc_curve, precision_recall_curve, accuracy_score
)
from sklearn.dummy import DummyClassifier
from sklearn.tree import DecisionTreeClassifier
from sklearn.neighbors import KNeighborsClassifier
from sklearn.naive_bayes import GaussianNB
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import RandomForestClassifier
from sklearn.inspection import permutation_importance

# LightGBM
import lightgbm as lgb

# Imbalanced-Learn
from imblearn.pipeline import Pipeline
from imblearn.under_sampling import RandomUnderSampler
from imblearn.over_sampling import SMOTE

# PyOD for Anomaly Detection
from pyod.models.iforest import IForest
from pyod.models.lof import LOF
from pyod.models.ocsvm import OCSVM

# Explainability
import shap

# ==========================================
# GLOBAL SETUP & CONFIGURATION
# ==========================================
class Config:
    DATA_PATH = 'creditcard.csv'
    RANDOM_STATE = 42
    SAMPLE_FRACTION = 0.2  # Toggle to 1.0 for full run, 0.2 for fast smoke tests
    TEST_SIZE = 0.15
    VAL_SIZE = 0.15 / (1.0 - TEST_SIZE) # Proportion of train to allocate to val (approx 0.176)
    CV_FOLDS = 5
    N_JOBS = -1
    PLOT_COLORS = sns.color_palette("Set2")

np.random.seed(Config.RANDOM_STATE)


# ==========================================
# TASK 1.1: Data Understanding & Preprocessing
# ==========================================
def load_and_profile_data(filepath):
    print("--- TASK 1.1: Data Loading & Profiling ---")
    if not os.path.exists(filepath):
        print(f"File {filepath} not found. Please ensure it is in the correct directory.")
        return None

    df = pd.read_csv(filepath)

    # Subsample for faster execution if required
    if Config.SAMPLE_FRACTION < 1.0:
        df = df.sample(frac=Config.SAMPLE_FRACTION, random_state=Config.RANDOM_STATE).reset_index(drop=True)

    print(f"Shape: {df.shape}")
    print(f"Missing Values: {df.isnull().sum().sum()}")
    print(f"Duplicates: {df.duplicated().sum()}")

    # Drop duplicates
    df.drop_duplicates(inplace=True)

    imbalance = df['Class'].value_counts(normalize=True)
    print(f"Class Distribution:\n{imbalance * 100}")

    # Collinear check
    corr_matrix = df.drop(['Class', 'Time'], axis=1).corr().abs()
    upper = corr_matrix.where(np.triu(np.ones(corr_matrix.shape), k=1).astype(bool))
    to_drop = [column for column in upper.columns if any(upper[column] > 0.95)]
    if to_drop:
        print(f"Dropping highly collinear features: {to_drop}")
        df.drop(columns=to_drop, inplace=True)

    return df

def perform_splits(df):
    """Creates Stratified and Time-ordered splits."""
    X = df.drop('Class', axis=1)
    y = df['Class']

    # 1. Stratified Split
    X_train_temp, X_test, y_train_temp, y_test = train_test_split(
        X, y, test_size=Config.TEST_SIZE, stratify=y, random_state=Config.RANDOM_STATE
    )
    X_train, X_val, y_train, y_val = train_test_split(
        X_train_temp, y_train_temp, test_size=Config.VAL_SIZE, stratify=y_train_temp, random_state=Config.RANDOM_STATE
    )

    # 2. Time-ordered Split
    df_sorted = df.sort_values('Time')
    n = len(df_sorted)
    train_end = int(n * 0.7)
    val_end = int(n * 0.85)

    df_time_train = df_sorted.iloc[:train_end]
    df_time_val = df_sorted.iloc[train_end:val_end]
    df_time_test = df_sorted.iloc[val_end:]

    time_splits = {
        'train': (df_time_train.drop('Class', axis=1), df_time_train['Class']),
        'val': (df_time_val.drop('Class', axis=1), df_time_val['Class']),
        'test': (df_time_test.drop('Class', axis=1), df_time_test['Class'])
    }

    return (X_train, X_val, X_test, y_train, y_val, y_test), time_splits

def get_preprocessor():
    """Builds preprocessor for scaling Amount and Time robustly."""
    return ColumnTransformer(
        transformers=[
            ('scaler', RobustScaler(), ['Time', 'Amount'])
        ],
        remainder='passthrough'
    )


# ==========================================
# TASK 1.2: Supervised Classification under Imbalance
# ==========================================
def run_baseline_and_models(X_train, y_train, X_val, y_val):
    print("\n--- TASK 1.2: Supervised Classification ---")
    preprocessor = get_preprocessor()

    # Baseline
    dummy = DummyClassifier(strategy='most_frequent')
    dummy.fit(X_train, y_train)

    models = {
        'DT': DecisionTreeClassifier(random_state=Config.RANDOM_STATE),
        'LR': LogisticRegression(max_iter=1000, random_state=Config.RANDOM_STATE),
        'RF': RandomForestClassifier(random_state=Config.RANDOM_STATE, n_jobs=Config.N_JOBS),
        'LGBM': lgb.LGBMClassifier(random_state=Config.RANDOM_STATE, n_jobs=Config.N_JOBS, verbose=-1)
    }

    # For speed in this template, we skip hyperparameter tuning via CV,
    # but the pipeline framework supports it (e.g. via RandomizedSearchCV).

    strategies = {
        'Baseline': None,
        'ClassWeight': 'balanced', # Passed directly to models supporting it
        'RUS': RandomUnderSampler(random_state=Config.RANDOM_STATE),
        'SMOTE': SMOTE(random_state=Config.RANDOM_STATE)
    }

    results = []

    # Limit to top 2 computationally efficient models for strategy comparison
    top_models = ['LR', 'LGBM']

    for m_name in top_models:
        for s_name, strategy in strategies.items():
            model = models[m_name]

            if s_name == 'ClassWeight':
                if hasattr(model, 'class_weight'):
                    model.set_params(class_weight='balanced')
                else:
                    continue
                steps = [('prep', preprocessor), ('clf', model)]
            elif strategy is not None:
                steps = [('prep', preprocessor), ('sampler', strategy), ('clf', model)]
            else:
                steps = [('prep', preprocessor), ('clf', model)]

            pipe = Pipeline(steps)
            pipe.fit(X_train, y_train)

            y_pred = pipe.predict(X_val)
            y_prob = pipe.predict_proba(X_val)[:, 1] if hasattr(pipe, 'predict_proba') else y_pred

            res = {
                'Model': m_name,
                'Strategy': s_name,
                'Precision': precision_score(y_val, y_pred, zero_division=0),
                'Recall': recall_score(y_val, y_pred),
                'F1': f1_score(y_val, y_pred),
                'MCC': matthews_corrcoef(y_val, y_pred),
                'ROC_AUC': roc_auc_score(y_val, y_prob),
                'PR_AUC': average_precision_score(y_val, y_prob)
            }
            results.append(res)

            # Reset class weight for next iterations
            if s_name == 'ClassWeight' and hasattr(model, 'class_weight'):
                model.set_params(class_weight=None)

    df_results = pd.DataFrame(results).sort_values(by='PR_AUC', ascending=False)
    print(df_results.to_markdown(index=False))
    return df_results, preprocessor

# ==========================================
# TASK 1.3: Evaluating Rare-Event Detectors Correctly
# ==========================================
def evaluate_best_model(pipe, X_test, y_test, X_val, y_val):
    print("\n--- TASK 1.3: Evaluation & Cost-Sensitive Analysis ---")
    y_prob_test = pipe.predict_proba(X_test)[:, 1]
    y_pred_test = pipe.predict(X_test)

    # 1. Accuracy Paradox Demo
    acc = accuracy_score(y_test, np.zeros_like(y_test))
    print(f"Naive Majority Classifier Accuracy: {acc*100:.2f}% (Recall=0, F1=0)")

    # 2. Cost-Sensitive Evaluation (Threshold Moving)
    def calculate_cost(y_true, y_prob, threshold, amounts):
        preds = (y_prob >= threshold).astype(int)
        false_negatives = (y_true == 1) & (preds == 0)
        false_positives = (y_true == 0) & (preds == 1)
        cost_fn = amounts[false_negatives].sum()
        cost_fp = false_positives.sum() * 5.0
        return cost_fn + cost_fp

    y_prob_val = pipe.predict_proba(X_val)[:, 1]
    thresholds = np.linspace(0.01, 0.99, 100)
    costs = [calculate_cost(y_val, y_prob_val, t, X_val['Amount'].values) for t in thresholds]

    opt_threshold = thresholds[np.argmin(costs)]
    print(f"Optimal Cost Threshold (Val): {opt_threshold:.3f}")

    cost_default = calculate_cost(y_test, y_prob_test, 0.5, X_test['Amount'].values)
    cost_opt = calculate_cost(y_test, y_prob_test, opt_threshold, X_test['Amount'].values)
    print(f"Test Cost (Default 0.5): ${cost_default:.2f}")
    print(f"Test Cost (Opt {opt_threshold:.3f}): ${cost_opt:.2f}")

    # 3. Plots
    fpr, tpr, _ = roc_curve(y_test, y_prob_test)
    pr, rc, _ = precision_recall_curve(y_test, y_prob_test)

    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 5))
    ax1.plot(fpr, tpr, label=f'ROC AUC={roc_auc_score(y_test, y_prob_test):.3f}')
    ax1.set_title("ROC Curve")
    ax1.legend()

    ax2.plot(rc, pr, label=f'PR AUC={average_precision_score(y_test, y_prob_test):.3f}')
    ax2.set_title("Precision-Recall Curve")
    ax2.legend()
    plt.tight_layout()
    plt.savefig('roc_pr_curves.png')
    # plt.show() # Uncomment to show interactively

# ==========================================
# TASK 1.4: Unsupervised & Semi-Supervised Anomaly Detection
# ==========================================
def anomaly_detection(X_train, y_train, X_test, y_test, preprocessor):
    print("\n--- TASK 1.4: Anomaly Detection ---")

    X_train_scaled = preprocessor.fit_transform(X_train)
    X_test_scaled = preprocessor.transform(X_test)

    # Semi-supervised setup (train only on normal)
    X_train_normal = X_train_scaled[y_train == 0]

    models = {
        'IForest': IForest(contamination=0.01, random_state=Config.RANDOM_STATE),
        'LOF': LOF(contamination=0.01, n_neighbors=20)
        # OCSVM omitted for speed with large samples, but can be added:
        # 'OCSVM': OCSVM(contamination=0.01)
    }

    for name, clf in models.items():
        # 1. Semi-Supervised
        clf.fit(X_train_normal)
        scores_test = clf.decision_function(X_test_scaled)
        # pyod outputs anomaly scores where higher is more anomalous
        pr_auc = average_precision_score(y_test, scores_test)
        print(f"[{name}] Semi-Supervised PR-AUC: {pr_auc:.4f}")

# ==========================================
# TASK 1.5: Temporal Drift & Unseen Threats
# ==========================================
def temporal_drift_analysis(pipe, time_splits):
    print("\n--- TASK 1.5: Temporal Drift Analysis ---")
    X_test_time, y_test_time = time_splits['test']

    # Split test set into 4 chunks based on chronological order
    chunks_X = np.array_split(X_test_time, 4)
    chunks_y = np.array_split(y_test_time, 4)

    recalls = []
    precisions = []

    for X_chunk, y_chunk in zip(chunks_X, chunks_y):
        y_pred = pipe.predict(X_chunk)
        if len(np.unique(y_chunk)) > 1: # Ensure there is fraud in the chunk
            recalls.append(recall_score(y_chunk, y_pred))
            precisions.append(precision_score(y_chunk, y_pred, zero_division=0))
        else:
            recalls.append(np.nan)
            precisions.append(np.nan)

    print("Temporal Windows Metrics:")
    print(f"Precisions over time: {precisions}")
    print(f"Recalls over time: {recalls}")

# ==========================================
# TASK 1.6: Model Explainability
# ==========================================
def explain_model(pipe, X_train, X_test, y_test):
    print("\n--- TASK 1.6: Model Explainability ---")

    # Extract preprocessor and LGBM classifier from pipeline
    preprocessor = pipe.named_steps['prep']
    clf = pipe.named_steps['clf']

    X_test_transformed = preprocessor.transform(X_test)

    # Feature names
    cat_feats = preprocessor.transformers_[0][2]
    num_feats = X_test.columns.drop(cat_feats).tolist()
    feature_names = cat_feats + num_feats

    X_test_df = pd.DataFrame(X_test_transformed, columns=feature_names)

    # 1. Feature Importance (Tree-based)
    if hasattr(clf, 'feature_importances_'):
        importances = pd.Series(clf.feature_importances_, index=feature_names)
        print("Top 10 Features (Gini):")
        print(importances.sort_values(ascending=False).head(10))

    # 2. SHAP Explanations
    print("Generating SHAP explanations (sampled for speed)...")
    sample_idx = np.random.choice(X_test_df.shape[0], 500, replace=False)
    X_sample = X_test_df.iloc[sample_idx]

    explainer = shap.TreeExplainer(clf)
    shap_values = explainer.shap_values(X_sample)

    # Create SHAP summary plot
    plt.figure()
    shap.summary_plot(shap_values, X_sample, show=False)
    plt.tight_layout()
    plt.savefig('shap_summary.png')
    print("Saved shap_summary.png")

# ==========================================
# MAIN EXECUTION FLOW
# ==========================================
def main():
    print("Starting Fraud Detection Pipeline...")

    # 1.1 Data Loading
    df = load_and_profile_data(Config.DATA_PATH)
    if df is None: return

    # Splits
    (X_train, X_val, X_test, y_train, y_val, y_test), time_splits = perform_splits(df)

    # 1.2 Model Training
    results, preprocessor = run_baseline_and_models(X_train, y_train, X_val, y_val)

    # Retrieve best pipeline for subsequent tasks (LGBM with no resampling usually performs best natively on PR-AUC)
    best_pipe = Pipeline([
        ('prep', preprocessor),
        ('clf', lgb.LGBMClassifier(random_state=Config.RANDOM_STATE, n_jobs=Config.N_JOBS, verbose=-1))
    ])
    best_pipe.fit(X_train, y_train)

    # 1.3 Evaluation
    evaluate_best_model(best_pipe, X_test, y_test, X_val, y_val)

    # 1.4 Anomaly Detection
    anomaly_detection(X_train, y_train, X_test, y_test, preprocessor)

    # 1.5 Temporal Drift
    temporal_drift_analysis(best_pipe, time_splits)

    # 1.6 Explainability
    explain_model(best_pipe, X_train, X_test, y_test)

    print("\nPipeline execution complete. See generated PNG files for plots.")

if __name__ == "__main__":
    main()
